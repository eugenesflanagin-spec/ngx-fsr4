#!/bin/bash
# ngx-fsr4: put the DLSS→FSR 4 stand-in into one Steam game's Proton prefix,
# with a manifest-driven backup so `disable` puts everything back.
#
#   ngx-fsr4 enable APPID [--ffx PATH] [--optiscaler-spoof]
#                                        install into the game's prefix;
#                                        --optiscaler-spoof keeps OptiScaler for
#                                        NVIDIA spoofing but turns off all its
#                                        input hooks so DLSS and FSR reach us
#   ngx-fsr4 disable APPID               undo exactly what enable did
#   ngx-fsr4 status [APPID]              what is enabled, where the backups are
#   ngx-fsr4 run APPID [--proton DIR] [--exe PATH] [--dry-run]
#                                        launch outside Steam's launch options,
#                                        with NVIDIA spoofing for the DLSS menu;
#                                        --dry-run prints what would run
#   ngx-fsr4 log APPID                   follow the newest stand-in log (beside
#                                        whichever copy of the DLL was loaded)
#
# Environment: NGX_FSR4_FFX (FSR runtime DLL for enable), NGX_FSR4_PROTON (Proton
# directory for run), STEAM_ROOT, NGX_FSR4_LIB.
set -euo pipefail

LIB=${NGX_FSR4_LIB:-/usr/lib/ngx-fsr4}
DATA=${XDG_DATA_HOME:-$HOME/.local/share}/ngx-fsr4
STEAM=${STEAM_ROOT:-$HOME/.local/share/Steam}
FFX_NAME=amd_fidelityfx_upscaler_dx12.dll
# OptiScaler / fakenvapi also answer DLSS calls; they are moved aside
CONFLICTS=(dxgi.dll OptiScaler.ini OptiScaler.log fakenvapi.ini fakenvapi.log nvapi64.dll)

die() { echo "ngx-fsr4: $*" >&2; exit 1; }
say() { echo "ngx-fsr4: $*"; }

libraries() {
    echo "$STEAM/steamapps"
    sed -n 's/^\s*"path"\s*"\(.*\)"/\1/p' "$STEAM/steamapps/libraryfolders.vdf" 2>/dev/null |
        while read -r p; do echo "$p/steamapps"; done
}

# sets GAME_DIR, PFX, NAME for an app id
find_game() {
    local id=$1 lib acf
    while IFS= read -r lib; do
        acf="$lib/appmanifest_$id.acf"
        [ -f "$acf" ] || continue
        NAME=$(sed -n 's/^\s*"name"\s*"\(.*\)"/\1/p' "$acf" | head -1)
        GAME_DIR="$lib/common/$(sed -n 's/^\s*"installdir"\s*"\(.*\)"/\1/p' "$acf" | head -1)"
        PFX="$lib/compatdata/$id/pfx"
        [ -d "$PFX/drive_c/windows/system32" ] || die "$NAME has no Proton prefix yet; launch it once from Steam first"
        return 0
    done < <(libraries | sort -u)
    die "app $id is not installed in any Steam library"
}

# FSR 4 runtime: --ffx, else $NGX_FSR4_FFX, else the newest copy in the places it is
# usually found (our data dir, GOverlay's FSR4 downloads, the package's lib dir)
find_ffx() {
    local c
    if [ -n "${NGX_FSR4_FFX:-}" ]; then echo "$NGX_FSR4_FFX"; return 0; fi
    for c in "$DATA/$FFX_NAME" "$LIB/$FFX_NAME"; do
        [ -f "$c" ] && { echo "$c"; return 0; }
    done
    c=$(ls -1d "${XDG_DATA_HOME:-$HOME/.local/share}"/goverlay/FSR4/*/"$FFX_NAME" 2>/dev/null | sort -V | tail -1)
    [ -n "$c" ] && { echo "$c"; return 0; }
    return 1
}

running() { pgrep -f "AppId=$1( |\$)" >/dev/null 2>&1; }
state() { echo "$DATA/enabled/$1"; }
sha() { sha256sum "$1" | cut -d' ' -f1; }

# OptiScaler's dxgi.dll / fakenvapi's nvapi64.dll only; never a game's own file
is_conflict() {
    local f=$1 base
    base=$(basename "$f")
    case "$base" in
    dxgi.dll) grep -a -q -i 'OptiScaler' "$f" ;;
    nvapi64.dll) grep -a -q -i 'fakenvapi' "$f" ;;
    *) return 0 ;;
    esac
}

# OptiScaler stays for spoofing only: every input hook off, so neither the
# game's DLSS calls nor our FidelityFX calls go through it
PASSTHROUGH_KEYS=(EnableDlssInputs EnableXeSSInputs EnableFsr2Inputs UseFsr2Inputs
    EnableFsr3Inputs UseFsr3Inputs EnableFfxInputs UseFfxInputs)
optiscaler_passthrough() {
    local ini=$1 k
    for k in "${PASSTHROUGH_KEYS[@]}"; do
        if grep -q "^$k *=" "$ini"; then
            sed -i "s/^$k *=.*/$k = false/" "$ini"
        else
            sed -i "s/^\\[Inputs\\]/[Inputs]\\n$k = false/" "$ini"
        fi
    done
}

cmd_enable() {
    local id=$1 ffx=$DEFAULT_FFX spoof=0
    shift
    while [ $# -gt 0 ]; do
        case $1 in
        --ffx) ffx=$2; shift 2 ;;
        --optiscaler-spoof) spoof=1; shift ;;
        *) die "unknown option $1" ;;
        esac
    done
    [ -f "$LIB/nvngx.dll" ] || die "$LIB/nvngx.dll missing (is the package installed?)"
    if [ -z "$ffx" ]; then
        ffx=$(find_ffx) || die "FSR 4 runtime ($FFX_NAME) not found. It is not shipped with ngx-fsr4;
  get it from AMD's FidelityFX SDK 2.x or a tool that downloads it (GOverlay keeps copies in
  ~/.local/share/goverlay/FSR4/<version>/), then either pass --ffx PATH, set NGX_FSR4_FFX=PATH,
  or copy it to $DATA/$FFX_NAME"
    fi
    [ -f "$ffx" ] || die "FSR runtime not found: $ffx (pass --ffx PATH to $FFX_NAME)"
    say "FSR runtime: $ffx"
    find_game "$id"
    [ -e "$(state "$id")" ] && die "already enabled for $NAME (backup: $(cat "$(state "$id")")); run: ngx-fsr4 disable $id"
    running "$id" && die "$NAME is running; quit it first"

    local bk="$DATA/backups/$id-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$bk/files" "$DATA/enabled"
    local man="$bk/manifest"
    printf '# ngx-fsr4 backup for %s (%s)\n# kind\tpath\tbackup\tsha256\n' "$NAME" "$id" >"$man"
    # record first, act second: an interrupted enable can still be undone
    echo "$bk" >"$(state "$id")"

    local sys="$PFX/drive_c/windows/system32" n=0 dst src
    for pair in "$LIB/nvngx.dll|_nvngx.dll" "$ffx|ngx-fsr4-upscaler.dll"; do
        src=${pair%%|*}
        dst="$sys/${pair##*|}"
        if [ -e "$dst" ]; then
            n=$((n + 1))
            cp -a "$dst" "$bk/files/$n"
            printf 'replaced\t%s\t%s\t%s\n' "$dst" "$bk/files/$n" "$(sha "$dst")" >>"$man"
        else
            printf 'added\t%s\t-\t-\n' "$dst" >>"$man"
        fi
        cp "$src" "$dst"
    done

    local d f
    while IFS= read -r -d '' d; do
        # the NGX loader in DLSS games also looks for nvngx.dll beside the game
        # (signature-checked; the override below lets ours through)
        if [ -f "$d/nvngx_dlss.dll" ] || [ -f "$d/sl.interposer.dll" ]; then
            f="$d/nvngx.dll"
            if [ -e "$f" ]; then
                n=$((n + 1))
                cp -a "$f" "$bk/files/$n"
                printf 'replaced\t%s\t%s\t%s\n' "$f" "$bk/files/$n" "$(sha "$f")" >>"$man"
            else
                printf 'added\t%s\t-\t-\n' "$f" >>"$man"
            fi
            cp "$LIB/nvngx.dll" "$f"
            f="$d/ngx-fsr4-upscaler.dll"
            if [ -e "$f" ]; then
                n=$((n + 1))
                cp -a "$f" "$bk/files/$n"
                printf 'replaced\t%s\t%s\t%s\n' "$f" "$bk/files/$n" "$(sha "$f")" >>"$man"
            else
                printf 'added\t%s\t-\t-\n' "$f" >>"$man"
            fi
            cp "$ffx" "$f"
        fi
        if [ $spoof = 1 ]; then
            # keep OptiScaler, but stop it answering DLSS itself
            f="$d/OptiScaler.ini"
            if [ -f "$d/dxgi.dll" ] && is_conflict "$d/dxgi.dll" && [ -f "$f" ]; then
                n=$((n + 1))
                cp -a "$f" "$bk/files/$n"
                printf 'replaced\t%s\t%s\t%s\n' "$f" "$bk/files/$n" "$(sha "$f")" >>"$man"
                optiscaler_passthrough "$f"
            fi
            continue
        fi
        for f in "${CONFLICTS[@]}"; do
            [ -f "$d/$f" ] || continue
            is_conflict "$d/$f" || continue
            n=$((n + 1))
            printf 'moved\t%s\t%s\t%s\n' "$d/$f" "$bk/files/$n" "$(sha "$d/$f")" >>"$man"
            mv "$d/$f" "$bk/files/$n"
        done
    done < <(find "$GAME_DIR" -maxdepth 5 -type f -iname '*.exe' -printf '%h\0' | sort -zu)

    # NVIDIA's loader only calls a signed _nvngx.dll unless signature checks are
    # overridden in this prefix (the switch OptiScaler's EnableSignatureOverride.reg sets)
    local reg="$PFX/system.reg"
    pgrep -x wineserver >/dev/null && say "warning: a wineserver is running; it may rewrite system.reg on exit"
    n=$((n + 1))
    cp -a "$reg" "$bk/files/$n"
    printf 'replaced\t%s\t%s\t%s\n' "$reg" "$bk/files/$n" "$(sha "$reg")" >>"$man"
    python3 - "$reg" <<'PY'
import sys, time
path = sys.argv[1]
text = open(path, encoding="utf-8", errors="surrogateescape").read()
head = r"[Software\\NVIDIA Corporation\\Global\\NGXCore]"
line = '"EnableSignatureOverride"=dword:00000001'
i = text.find(head)
if i < 0:
    text = text.rstrip("\n") + "\n\n%s %d\n#time=0\n%s\n%s\n" % (
        head, int(time.time()), r'"FullPath"="C:\\Windows\\System32"', line)
else:
    end = text.find("\n\n", i)
    end = len(text) if end < 0 else end
    if "EnableSignatureOverride" not in text[i:end]:
        text = text[:end] + "\n" + line + text[end:]
open(path, "w", encoding="utf-8", errors="surrogateescape").write(text)
PY
    say "enabled for $NAME"
    sed -n 's/^\(added\|replaced\|moved\)\t\([^\t]*\).*/  \1  \2/p' "$man"
    [ $spoof = 1 ] && say "OptiScaler kept for spoofing only (all its input hooks off); launch with: ngx-fsr4 run $id"
    say "backup: $bk"
    say "undo:   ngx-fsr4 disable $id"
}

cmd_disable() {
    local id=$1 bk man kind path backup hash bad=0
    find_game "$id"
    [ -e "$(state "$id")" ] || die "not enabled for $NAME"
    running "$id" && die "$NAME is running; quit it first"
    bk=$(cat "$(state "$id")")
    man="$bk/manifest"
    [ -f "$man" ] || die "manifest missing: $man"
    # undo in reverse order
    while IFS=$'\t' read -r kind path backup hash; do
        case $kind in
        added) rm -f "$path" ;;
        replaced | moved)
            if [ ! -f "$backup" ]; then
                echo "  missing backup for $path" >&2
                bad=1
                continue
            fi
            if [ "$(sha "$backup")" != "$hash" ]; then
                echo "  checksum mismatch for $backup" >&2
                bad=1
                continue
            fi
            if [ "$kind" = moved ]; then mv "$backup" "$path"; else cp -a "$backup" "$path"; fi
            ;;
        esac
    done < <(grep -v '^#' "$man" | tac)
    [ $bad = 0 ] || die "some files could not be restored; backup kept at $bk"
    rm -f "$(state "$id")"
    say "disabled for $NAME; everything put back (backup kept at $bk)"
    say "note: GOverlay's launcher re-copies OptiScaler on its next launch anyway"
}

cmd_status() {
    local f id
    shopt -s nullglob
    local any=0
    for f in "$DATA"/enabled/*; do
        id=$(basename "$f")
        [ -n "${1:-}" ] && [ "$1" != "$id" ] && continue
        any=1
        find_game "$id"
        echo "$id  $NAME  enabled  backup: $(cat "$f")"
    done
    [ $any = 1 ] || echo "not enabled for any game"
}

# Proton for an app: Steam's own choice for this game (CompatToolMapping in
# config.vdf, then the global default), resolved to a directory with a "proton" script
steam_compat_tool() {
    python3 - "$STEAM" "$1" <<'PY'
import os, re, sys, glob
steam, app = sys.argv[1], sys.argv[2]
try:
    cfg = open(os.path.join(steam, "config", "config.vdf"), errors="replace").read()
except OSError:
    sys.exit(1)
i = cfg.find('"CompatToolMapping"')
if i < 0:
    sys.exit(1)
seg = cfg[i:]
def mapped(a):
    m = re.search(r'\n\s*"%s"\s*\{\s*"name"\s*"([^"]*)"' % re.escape(a), seg)
    return m.group(1) if m and m.group(1) else None
names = [n for n in (mapped(app), mapped("0")) if n]
tools = {}
for vdf in glob.glob(os.path.join(steam, "compatibilitytools.d", "*", "compatibilitytool.vdf")):
    m = re.search(r'"compat_tools"\s*\{\s*"([^"]+)"', open(vdf, errors="replace").read())
    if m:
        tools[m.group(1)] = os.path.dirname(vdf)
for n in names:
    d = tools.get(n) or os.path.join(steam, "compatibilitytools.d", n)
    if os.access(os.path.join(d, "proton"), os.X_OK):
        print(d)
        sys.exit(0)
sys.exit(1)
PY
}

# every Proton build Steam can see: compatibilitytools.d and steamapps/common/Proton*
all_protons() {
    local lib d
    for d in "$STEAM"/compatibilitytools.d/*/; do
        [ -x "$d/proton" ] && echo "${d%/}"
    done
    while IFS= read -r lib; do
        for d in "$lib"/common/Proton*/; do
            [ -x "$d/proton" ] && echo "${d%/}"
        done
    done < <(libraries | sort -u)
    return 0
}

cmd_run() {
    local id=$1 proton="${NGX_FSR4_PROTON:-}" exe="" dry=0 how="NGX_FSR4_PROTON"
    shift
    while [ $# -gt 0 ]; do
        case $1 in
        --proton) proton=$2; how="--proton"; shift 2 ;;
        --exe) exe=$2; shift 2 ;;
        --dry-run | -n) dry=1; shift ;;
        *) die "unknown option $1" ;;
        esac
    done
    find_game "$id"
    [ -e "$(state "$id")" ] || [ $dry = 1 ] || die "not enabled for $NAME; run: ngx-fsr4 enable $id"
    if [ -z "$proton" ]; then
        if proton=$(steam_compat_tool "$id"); then
            how="Steam's compatibility tool setting"
        else
            local found
            mapfile -t found < <(all_protons | sort -u)
            case ${#found[@]} in
            0) die "no Proton found in $STEAM/compatibilitytools.d or steamapps/common; pass --proton DIR" ;;
            1) proton=${found[0]}; how="the only Proton installed" ;;
            *) die "several Proton builds found and Steam names none for this game; pick one with --proton DIR (or NGX_FSR4_PROTON):
$(printf '  %s\n' "${found[@]}")" ;;
            esac
        fi
    fi
    [ -x "$proton/proton" ] || die "not a Proton directory (no executable 'proton' in it): $proton"
    if [ -z "$exe" ]; then
        local exes
        # top-level .exe files, minus the usual helpers
        mapfile -t exes < <(find "$GAME_DIR" -maxdepth 1 -type f -iname '*.exe' \
            ! -iname 'unins*' ! -iname '*setup*' ! -iname '*redist*' ! -iname '*crash*' \
            ! -iname 'easyanticheat*' ! -iname '*uninstall*' | sort)
        case ${#exes[@]} in
        0) die "no game .exe in $GAME_DIR; pass --exe PATH" ;;
        1) exe=${exes[0]} ;;
        *) die "several .exe files in $GAME_DIR; pass --exe PATH:
$(printf '  %s\n' "${exes[@]}")" ;;
        esac
    fi
    [ -f "$exe" ] || die "game executable not found: $exe"
    if [ $dry = 1 ]; then
        say "would launch $NAME"
        say "  proton: $proton ($how)"
        say "  exe:    $exe"
        [ -e "$(state "$id")" ] || say "  (not enabled yet: run ngx-fsr4 enable $id first)"
        return 0
    fi
    pgrep -x steam >/dev/null || say "warning: Steam is not running; Steam games usually need it"
    # launchers such as GOverlay's bgmod rewrite OptiScaler.ini; re-assert ours
    local ini
    while IFS=$'\t' read -r _ ini _; do
        case $ini in
        */OptiScaler.ini) [ -f "$ini" ] && optiscaler_passthrough "$ini" ;;
        esac
    done < <(grep -P '^replaced\t' "$(cat "$(state "$id")")/manifest")
    say "launching $NAME with $(basename "$proton") ($how)"
    say "log: ngx-fsr4 log $id"
    export STEAM_COMPAT_DATA_PATH="${PFX%/pfx}" STEAM_COMPAT_CLIENT_INSTALL_PATH="$STEAM"
    export SteamAppId=$id SteamGameId=$id
    # make the game see an NVIDIA GPU so it offers DLSS
    export PROTON_FORCE_NVAPI=1 DXVK_NVAPI_ALLOW_OTHER_DRIVERS=1
    export DXVK_NVAPI_GPU_ARCH=${DXVK_NVAPI_GPU_ARCH:-AD100}
    export DXVK_NVAPI_DRIVER_VERSION=${DXVK_NVAPI_DRIVER_VERSION:-58000}
    # appear as an RTX 4090 (the identity OptiScaler spoofs too)
    export DXVK_CONFIG="dxgi.hideAmdGpu=True;dxgi.customVendorId=10de;dxgi.customDeviceId=2684${DXVK_CONFIG:+;$DXVK_CONFIG}"
    # Proton debug logging costs real frame time; opt in with PROTON_LOG=1
    cd "$(dirname "$exe")"
    exec python3 "$proton/proton" waitforexitandrun "$exe"
}

cmd_log() {
    find_game "$1"
    local log="$PFX/drive_c/windows/system32/ngx-fsr4.log"
    [ -f "$log" ] || die "no log yet: $log"
    exec tail -n 50 -F "$log"
}

[ $# -ge 1 ] || { sed -n '2,/^set -e/{/^#/p}' "$0" | sed 's/^# \{0,1\}//'; exit 1; }
cmd=$1
shift
case $cmd in
enable | disable | run | log) [ $# -ge 1 ] || die "usage: ngx-fsr4 $cmd APPID"; "cmd_$cmd" "$@" ;;
status) cmd_status "$@" ;;
-h | --help | help) sed -n '2,/^set -e/{/^#/p}' "$0" | sed 's/^# \{0,1\}//' ;;
*) die "unknown command $cmd" ;;
esac
